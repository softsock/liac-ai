{
  "name": "liac-vtuber-hub",
  "productName": "Liac VTuber Hub",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "npm run build:main && tsc --noEmit && vite build",

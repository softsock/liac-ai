    "test": "npm run build:main && node --experimental-strip-types --test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.3.4",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
